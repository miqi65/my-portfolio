{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules*",
    "public/Project_P2/source",
    "public/pcb",
    "app/work/factory/vite.config.ts",
    "app/work/factory/src/main.tsx",
    "app/work/factory/src/app/components",
    "app/work/factory/src/imports/友讯达数据大屏/index.tsx",
    "app/work/5G/vite.config.ts",
    "app/work/5G/src/main.tsx",
    "app/work/5G/src/app/components",
    "app/work/5G/src/imports/5Gchatbot/index.tsx"
  ]
}
